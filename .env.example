NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Public browser-safe Supabase values.
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only privileged key. Never expose with the NUXT_PUBLIC_ prefix.
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
