NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Public browser-safe Supabase values.
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only privileged key. Never expose with the NUXT_PUBLIC_ prefix.
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Observability. DSN is server-only until the Sentry Nuxt SDK is installed and validated.
NUXT_SENTRY_DSN=
NUXT_SENTRY_ENVIRONMENT=development
NUXT_SENTRY_RELEASE=coursia-web-local
NUXT_SENTRY_SOURCEMAPS=false
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
NUXT_PUBLIC_SENTRY_RELEASE=coursia-web-local

# Internal admin documentation links. Browser-safe URLs only, no tokens.
NUXT_PUBLIC_DOCS_JIRA_URL=https://hedsdev2025.atlassian.net
NUXT_PUBLIC_DOCS_REPOSITORY_URL=
NUXT_PUBLIC_DOCS_SUPABASE_URL=
NUXT_PUBLIC_DOCS_SENTRY_URL=
NUXT_PUBLIC_DOCS_POSTHOG_URL=
