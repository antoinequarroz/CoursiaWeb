# Canonical preview URL. Must be HTTPS on shared preview environments.
NUXT_PUBLIC_SITE_URL=https://preview.example.com

# Preview / preproduction Supabase project.
NUXT_PUBLIC_SUPABASE_URL=https://your-preview-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-preview-publishable-key

# Server-only. Configure in the hosting provider secret store.
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-preview-server-only-service-role-key

# Observability. Keep source maps disabled unless release upload is configured.
NUXT_SENTRY_DSN=
NUXT_SENTRY_ENVIRONMENT=preview
NUXT_SENTRY_RELEASE=coursia-web-preview
NUXT_SENTRY_SOURCEMAPS=false
NUXT_PUBLIC_SENTRY_ENVIRONMENT=preview
NUXT_PUBLIC_SENTRY_RELEASE=coursia-web-preview

# Internal admin documentation links. Browser-safe URLs only, no tokens.
NUXT_PUBLIC_DOCS_JIRA_URL=https://hedsdev2025.atlassian.net
NUXT_PUBLIC_DOCS_REPOSITORY_URL=
NUXT_PUBLIC_DOCS_SUPABASE_URL=
NUXT_PUBLIC_DOCS_SENTRY_URL=
NUXT_PUBLIC_DOCS_POSTHOG_URL=
